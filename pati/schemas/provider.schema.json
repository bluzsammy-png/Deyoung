{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pati.local/schemas/provider.schema.json",
  "type": "object",
  "required": [
    "provider_id",
    "kind",
    "free_status"
  ],
  "properties": {
    "provider_id": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "compute",
        "model",
        "storage",
        "api",
        "connector"
      ]
    },
    "free_status": {
      "type": "string"
    },
    "cost": {
      "type": "number",
      "maximum": 0
    },
    "license": {
      "type": "string"
    },
    "last_verified": {
      "type": "string"
    }
  }
}