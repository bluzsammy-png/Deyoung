<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key><string>com.pati.agent</string>
    <key>ProgramArguments</key>
    <array>
        <string>USER_HOME/.pati/venv/bin/pati-agent</string>
        <string>run</string>
    </array>
    <key>RunAtLoad</key><true/>
    <key>KeepAlive</key><true/>
    <key>StandardOutPath</key><string>USER_HOME/.pati/agent/agent.log</string>
    <key>StandardErrorPath</key><string>USER_HOME/.pati/agent/agent.err.log</string>
</dict>
</plist>
