# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/
# campaign intermediates
/campaign/
/download/
/upload/
/db/

# DeYoung v3 film working media (heavy) — only the final master ships via public/video
campaign/film/v3/clips/
campaign/film/v3/seg_*.mp4
campaign/film/v3/caps/
campaign/film/v3/concat.txt

# worker-delivered renders (runtime media, never commit)
/public/uploads/

# SECURITY: worker secrets vault (Kaggle tokens etc.) — NEVER commit, NEVER list contents in chat artifacts
/workers/secrets/

# brain runtime churn (events log only; brain/state.json is committed on real changes)
/brain/events.log
/brain/loop.pid
/brain/loop.out
brain/*.tmp

# transient tool artifacts
/tool-results/

# W1 object-storage local driver (dev only — ephemeral, never commit)
/media/

# W1 isolated postgres client for e2e testing (regenerable)
/prisma/pg-client-tmp/
/prisma/_pggen.prisma

# python bytecode must never be tracked (W41: auto-snapshot committed .pyc binaries)
__pycache__/
*.pyc

# brain runtime out files (loop/one-shot wrapper stdout)
/brain/*.out
