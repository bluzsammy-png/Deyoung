generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Owner account — only the site owner can log in to /admin
model Admin {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Single-row site configuration, editable from the admin panel
model Settings {
  id                  String   @id @default("main")
  siteName            String   @default("DeYoung")
  tagline             String   @default("Bold work. Real results.")
  heroTitle           String   @default("DEYOUNG")
  heroSubtitle        String   @default("Creative work that gets you noticed — shot, designed and delivered fast.")
  aboutTitle          String   @default("About DeYoung")
  aboutBody           String   @default("")
  ownerName           String   @default("DeYoung")
  ownerTitle          String   @default("Creative Professional")
  ownerPhotoUrl       String   @default("/img/avatar-default.png")
  contactEmail        String   @default("hello@deyoung.site")
  phone               String   @default("")
  whatsapp            String   @default("")
  location            String   @default("")
  responseTime        String   @default("I reply within 24 hours — usually much faster.")
  currency            String   @default("USD")
  paymentProvider     String   @default("manual") // manual | paystack | flutterwave | paypal | stripe
  paymentPublicKey    String   @default("")
  paymentSecretKey    String   @default("")
  paymentLinkUrl      String   @default("")
  paymentInstructions String   @default("Pay via bank transfer or mobile money using the details below, then send your receipt on WhatsApp. Your booking is confirmed as soon as payment is received.")
  bankDetails         String   @default("")
  socialJson          String   @default("{}")
  metaDescription     String   @default("DeYoung — AI video generation up to 60 seconds in one pass, plus bold creative services. Subscribe or book online, pay locally or internationally.")
  gpuMinutesDaily     Int      @default(240) // honest daily render budget (free GPU supply)
  updatedAt           DateTime @updatedAt
}

model Photo {
  id        String   @id @default(cuid())
  title     String
  alt       String   @default("")
  url       String
  category  String   @default("work") // work | ai-film | style-lab (gallery filter)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}

model Service {
  id          String  @id @default(cuid())
  title       String
  description String
  price       Float   @default(0)
  compareAtPrice Float? // optional "was" price shown struck-through
  duration    String  @default("")
  active      Boolean @default(true)
  sortOrder   Int     @default(0)
}

model Booking {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String   @default("")
  serviceTitle String
  amount       Float
  currency     String   @default("USD")
  status       String   @default("pending") // pending | paid | confirmed | cancelled
  provider     String   @default("manual")
  paymentRef   String   @default("")
  notes        String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Testimonial {
  id        String  @id @default(cuid())
  name      String
  role      String  @default("")
  quote     String
  rating    Int     @default(5)
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  sortOrder Int     @default(0)
  active    Boolean @default(true)
}

// Subscription tier — Beginner / Pro / Elite. Every limit is owner-editable from /admin.
model Plan {
  id              String  @id @default(cuid())
  code            String  @unique // beginner | pro | elite
  name            String
  blurb           String  @default("")
  priceMonthly    Float   @default(0)
  compareAtPrice  Float? // optional "was" price shown struck-through
  currency        String  @default("USD")
  maxVideosMonth  Int     @default(4)
  maxSecondsVideo Int     @default(15)
  maxResolution   String  @default("720p") // 720p | 1080p
  watermark       Boolean @default(true)
  concurrentJobs  Int     @default(1)
  queuePriority   Int     @default(0) // higher = rendered sooner
  commercial      Boolean @default(false)
  audio           Boolean @default(false)
  featuresJson    String  @default("[]") // [{ "label": "...", "included": true }]
  active          Boolean @default(true)
  sortOrder       Int     @default(0)
}

// A customer's monthly subscription to one of the plans.
model Subscription {
  id          String    @id @default(cuid())
  name        String
  email       String
  phone       String    @default("")
  planCode    String
  status      String    @default("pending") // pending | active | expired | cancelled
  periodStart DateTime?
  periodEnd   DateTime?
  pricePaid   Float     @default(0)
  currency    String    @default("USD")
  provider    String    @default("manual")
  paymentRef  String    @default("")
  notes       String    @default("")
  userId      String? // W2: set when created by a signed-in user (registration flow)
  user        User?     @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
}

// One video generation job bought with subscription quota. Queue-first by design.
model VideoRequest {
  id             String   @id @default(cuid())
  subscriptionId String
  email          String
  prompt         String
  seconds        Int
  resolution     String   @default("720p")
  withAudio      Boolean  @default(false)
  watermark      Boolean  @default(true)
  queuePriority  Int      @default(0)
  status         String   @default("queued") // queued | rendering | done | failed | cancelled
  resultUrl      String   @default("")
  resultAssetId  String?
  resultFor      Asset?   @relation(fields: [resultAssetId], references: [id])
  gpuMinutes     Float    @default(0)
  dedupKey       String   @default("") // sha256(prompt+params) — identical renders are reused
  fromCache      Boolean  @default(false)
  notes          String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// W1 storage_v2 (spec D.1/E.6): metadata for every stored media object.
// Bytes live in object storage (Supabase Storage or local dev dir) — never in Postgres.
model Asset {
  id         String   @id @default(cuid())
  kind       String
  mime       String
  bytes      Int
  storageKey String   @unique
  driver     String
  isPublic   Boolean  @default(false)
  sha256     String?
  createdBy  String   @default("admin")
  resultFor  VideoRequest[]
  createdAt  DateTime @default(now())
}

// W1 (spec §F.2): Postgres-backed fixed-window rate-limit counters.
// Survives restarts, works across instances, and is inspectable by the admin
// Security panel. `bucket` = "<class>:<ip>"; the in-memory limiter remains as
// a fallback if the DB is unreachable (see src/lib/ratelimit.ts).
model RateLimit {
  id        String   @id @default(cuid())
  bucket    String   @unique
  count     Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

// W2 (Task 42): site user - signs up, subscribes, runs the AI Film Studio.
// Google-only accounts have a null passwordHash. status gates every guarded
// route: banned/deactivated users fail closed with their reason surfaced.
model User {
  id             String           @id @default(cuid())
  email          String           @unique
  name           String           @default("")
  passwordHash   String? // null for Google-only accounts
  provider       String           @default("credentials") // credentials | google
  googleId       String?          @unique
  image          String           @default("")
  role           String           @default("user") // user | admin
  status         String           @default("active") // active | banned | deactivated
  banReason      String           @default("")
  lastLoginAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  subscriptions  Subscription[]
  studioProjects StudioProject[]
}

// W2: saved AI Film Studio work - brief, niche, generated script (characters +
// scenes) and render linkage. scriptJson shape: { title, logline, characters:
// [{name, look, voice}], scenes: [{ id, title, seconds, line, visual }] }.
model StudioProject {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  title      String
  niche      String   @default("")
  brief      String   @default("")
  scriptJson String   @default("{}")
  status     String   @default("draft") // draft | scripted | rendering | done
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}
